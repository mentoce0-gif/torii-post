# Copy to .env for local runs. Never commit a filled-in .env.
PORT=8787
HOST=127.0.0.1

# sqlite | (future: postgres)
DB_DRIVER=sqlite
DB_PATH=./data/poc.sqlite

# poc  = ship only curated + sourced facility values; everything else stays ？
# demo = additionally load clearly-labelled placeholder observations so the UI
#        can be demonstrated. The app shows a "demo data" banner in this mode.
SEED_PROFILE=poc

# sqlite | console | none
ANALYTICS_PROVIDER=sqlite

# schematic | external_link
MAP_PROVIDER=schematic

# Requests per minute per client for write endpoints. 0 disables the limiter.
RATE_LIMIT_PER_MIN=60

# Required to read /api/metrics from anything other than a loopback address.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKEN=
