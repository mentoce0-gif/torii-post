{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "preserve",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "types": ["@cloudflare/workers-types", "node"]
  },
  "include": ["src/worker/**/*.ts", "src/server/**/*.ts"],
  "exclude": ["src/server/main.ts", "src/server/http/server.ts", "src/server/http/static.ts", "src/server/data/sqliteRepository.ts", "src/server/data/driver.ts"]
}
