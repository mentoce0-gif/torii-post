# Copy to .env for local runs. Never commit a filled-in .env.
PORT=8787
HOST=127.0.0.1

# sqlite | (future: postgres)
DB_DRIVER=sqlite
DB_PATH=./data/poc.sqlite

# poc  = ship only curated + sourced facility values; everything else stays ？
# demo = additionally load clearly-labelled placeholder observations so the UI
#        can be demonstrated. The app shows a "demo data" banner in this mode.
SEED_PROFILE=poc

# sqlite | console | none
ANALYTICS_PROVIDER=sqlite

# schematic | external_link
MAP_PROVIDER=schematic

# Requests per minute per client for write endpoints. 0 disables the limiter.
RATE_LIMIT_PER_MIN=60

# Same, for reads. These were uncapped until the service went public: a GET
# costs a SQLite read and needs no account, so it is the cheapest way in.
RATE_LIMIT_READ_PER_MIN=240

# Believe X-Forwarded-For for the client address. Turn this on ONLY when the
# process sits behind a proxy that overwrites the header (your TLS terminator).
# On a directly-exposed port the header is whatever the caller typed, and
# trusting it hands every request a fresh identity — the limiter stops working.
# Leave it false and the limiter falls back to the socket address.
TRUST_PROXY=false

# Where a household starts before it has said, and before/without a GPS fix.
# The response marks this origin as `default` and the screen labels it 「（既定）」:
# the app starts somewhere, it never claims to know where the household is.
DEFAULT_AREA_CODE=shiga-otsu

# Required to read /api/metrics from anything other than a loopback address.
# Generate with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
METRICS_TOKEN=
