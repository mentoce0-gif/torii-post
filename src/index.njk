---
layout: layouts/base.njk
permalink: /
---
<section class="hero">
  <div class="container">
    <p class="eyebrow reveal">Field notes from Japan</p>
    <h1 class="reveal">Buy from Japan,<br>without the guesswork.</h1>
    <p class="hero-copy reveal">
      Independent guides to Japan's shops, marketplaces, and quiet corners —
      written from inside the country, tested with our own money, and free of
      the vendor spin that fills this corner of the internet.
    </p>
  </div>
</section>

<section class="guides-section" id="guides">
  <div class="container">
    <div class="section-index reveal">Latest guides</div>
    {% for post in collections.posts | reverse %}
    <div class="guide-row reveal">
      <span class="guide-date">{{ post.date | readableDate }}</span>
      <a href="{{ post.url }}">
        <h3>{{ post.data.title }}</h3>
        <p>{{ post.data.description }}</p>
      </a>
    </div>
    {% endfor %}
  </div>
</section>
