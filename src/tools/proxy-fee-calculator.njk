    cursor: pointer;
    font: inherit;
    font-size: 14px;
    font-weight: 600;
    width: 100%;
    transition: background .2s, border-color .2s;
  }
  .btn-add:hover { background: var(--accent-soft); border-color: var(--accent); }

  .calc-opt {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
