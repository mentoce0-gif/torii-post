</style>

<div class="calc-wrap"><div class="container">

  <div class="calc-head">
    <h1>Japan Proxy Fee Calculator</h1>
    <p>Every proxy service looks cheapest in its own comparison table. Put your <em>actual</em> cart in below and the arithmetic decides instead.</p>
    <p>Nothing is sent anywhere — this runs entirely in your browser.</p>
  </div>

  <div class="calc-grid">

    <div class="calc-panel">
      <h2>Your cart</h2>
      <div id="items"></div>
      <button type="button" class="btn-add" id="addItem">+ Add another item</button>

      <div class="calc-opt">
        <div>
          <strong><label for="domestic">Domestic shipping per seller</label></strong>
          <span>Each seller ships to the proxy's warehouse separately. Usually ¥500–1,000.</span>
        </div>
        <input type="number" id="domestic" value="650" min="0" step="50" inputmode="numeric">
      </div>

      <div class="calc-opt">
        <div>
          <strong><label for="packing">Small parcel (under 2 kg)</label></strong>
          <span>Neokyo adds a ¥500 packing fee below 2 kg. Others don't.</span>
        </div>
        <input type="checkbox" id="packing">
      </div>
    </div>

    <div class="calc-panel">
      <h2>What each service would charge</h2>
      <div id="results"></div>
      <p class="calc-verified">Cheapest is not automatically best. Fees are the one thing arithmetic can settle; marketplace coverage, payment options, packing quality and how fast a service moves during a sale rush are not in these numbers. The <a href="/guides/japan-proxy-shopping-services-compared/" style="color:var(--accent);text-decoration:underline;text-underline-offset:2px">full guide</a> covers what each one trades away.</p>
      <p class="calc-verified">Buyee is calculated with its ¥0 Lite guarantee plan. The Standard plan it recommends adds ¥500 per order, and its package consolidation fee is left out entirely because we could not confirm the current figure against Buyee's own pricing page — we would rather leave a gap than guess at it.</p>
      <p class="calc-verified">Buyee fees re-checked against Buyee's published pricing in August 2026; the other four were verified in July 2026. Services change pricing more often than you'd expect — check current rates before a large order.</p>
    </div>

  </div>

  <div class="calc-note">
    <strong>What this does not include, and why</strong>
    International shipping is deliberately left out. It is charged by weight or box volume — whichever is greater — so it depends on what you bought, not on which service you used, and no calculator can guess it honestly from a price alone. Two other costs are worth knowing about but can't be modelled either:
    <ul>
      <li><strong>Currency conversion.</strong> Some services apply their own exchange rate with a 2–4% spread built in. On a ¥50,000 order that is up to ¥2,000, invisibly.</li>
      <li><strong>Packing quality.</strong> A roomier box quietly raises the international rate and can erase every yen you saved on fees.</li>
    </ul>
  </div>

  <p class="calc-back">This calculator is the companion to our full breakdown: <a href="/guides/japan-proxy-shopping-services-compared/">Japan proxy shopping services compared</a> — what each one is actually good at, and the four hidden costs that decide your real total.</p>

</div></div>

<script>
(function () {
  var itemsEl = document.getElementById('items');
  var resultsEl = document.getElementById('results');
  var domesticEl = document.getElementById('domestic');
  var packingEl = document.getElementById('packing');
  var seq = 0;

  // Seeded with the worked example from the guide so the page is useful the
  // moment it loads: a figure, a manga lot and a CD from three sellers.
  var SEED = [
    { price: 8000, store: 'AmiAmi' },
    { price: 3500, store: 'Mercari seller' },
    { price: 2000, store: 'Yahoo! Auctions seller' }
  ];

  function yen(n) {
    return '¥' + Math.round(n).toLocaleString('en-US');
  }

  function addRow(price, store) {
    var id = ++seq;
    var row = document.createElement('div');
    row.className = 'item-row';
    row.innerHTML =
      '<div><label for="p' + id + '">Item price (¥)</label>' +
      '<input type="number" id="p' + id + '" class="i-price" min="0" step="100" inputmode="numeric" value="' + (price || '') + '"></div>' +
      '<div><label for="s' + id + '">Seller / shop</label>' +
      '<input type="text" id="s' + id + '" class="i-store" placeholder="e.g. AmiAmi" value="' + (store || '') + '"></div>' +
      '<button type="button" class="btn-remove" aria-label="Remove this item">×</button>';
    itemsEl.appendChild(row);
  }

  function readCart() {
    var rows = itemsEl.querySelectorAll('.item-row');
    var items = [];
    rows.forEach(function (row, i) {
      var price = parseFloat(row.querySelector('.i-price').value);
      if (!isFinite(price) || price <= 0) return;
      var store = row.querySelector('.i-store').value.trim().toLowerCase();
      // An unnamed seller is treated as its own shop — that is the safe
      // assumption, since it costs a separate domestic shipment.
      items.push({ price: price, store: store || ('__row' + i) });
    });
    return items;
  }

  // A ranking with no reasoning behind it is just an advert with a badge on it.
  // Say which structural feature won, so the reader can check it against
  // their own cart rather than trusting the number.
  function explain(winner, stores, goods, n) {
    var why = {
      'Neokyo': 'Neokyo wins here because its ¥350 per item already covers domestic shipping to the warehouse, and you are paying ' + stores + ' separate domestic shipment' + (stores > 1 ? 's' : '') + ' everywhere else. Lower the domestic figure and this lead narrows.',
      'ZenMarket': 'The flat ¥300 wins here because your items are expensive enough that a percentage fee costs more than a fixed one.',
      'Buyee': 'Buyee wins here because its ¥500 is charged per order rather than per item: you are buying ' + n + ' items across ' + stores + ' shop' + (stores > 1 ? 's' : '') + ', so the fee stops climbing while the per-item services keep going. Split the same cart across more shops and it reverses.',
      'FROM JAPAN': 'FROM JAPAN wins here because its ¥800 per-shop cap kicks in: you are buying ' + n + ' items from only ' + stores + ' shop' + (stores > 1 ? 's' : '') + ', so the per-item fee stops climbing.'
    };
    if (!why[winner]) return '';
    return '<p class="calc-why"><strong>Why:</strong> ' + why[winner] + '</p>';
  }

  function calculate() {
    var items = readCart();
    var domestic = Math.max(0, parseFloat(domesticEl.value) || 0);
    var smallParcel = packingEl.checked;

    if (!items.length) {
      resultsEl.innerHTML = '<p style="color:var(--muted);font-size:14px;margin:0">Enter at least one item price to see the comparison.</p>';
      return;
    }

    var n = items.length;
    var goods = items.reduce(function (s, it) { return s + it.price; }, 0);

    // Items from the same seller travel in one domestic shipment.
    var byStore = {};
    items.forEach(function (it) {
      byStore[it.store] = (byStore[it.store] || 0) + 1;
    });
    var storeCount = Object.keys(byStore).length;
    var domesticTotal = storeCount * domestic;

    // FROM JAPAN caps its per-item fee at ¥800 per store order.
    var fjFee = Object.keys(byStore).reduce(function (s, k) {
      return s + Math.min(300 * byStore[k], 800);
    }, 0);

    var services = [
      {
        name: 'ZenMarket',
        fee: 300 * n,
        shipping: domesticTotal,
        extra: 0,
        note: '¥300 flat × ' + n + ' item' + (n > 1 ? 's' : '') + ', free consolidation'
      },
      {
        // Buyee's purchase fee is flat per order, not a percentage. Their own
        // fees page is explicit that a second item in the same order does not
        // add to it, so this scales with shops, not with items or with price.
        name: 'Buyee',
        fee: 500 * storeCount,
        shipping: domesticTotal,
        extra: 0,
        note: '¥500 flat × ' + storeCount + ' order' + (storeCount > 1 ? 's' : '') + ', any number of items each'
      },
      {
        name: 'FROM JAPAN',
        fee: fjFee,
        shipping: domesticTotal,
        extra: 0,
        note: '¥300/item, capped at ¥800 per shop — ' + storeCount + ' shop' + (storeCount > 1 ? 's' : '')
      },
      {
        name: 'Neokyo',
        fee: 350 * n,
        shipping: 0,
        extra: smallParcel ? 500 : 0,
        note: '¥350 × ' + n + ', domestic shipping included' + (smallParcel ? ', + ¥500 packing' : '')
      }
    ];

    services.forEach(function (s) {
      s.addOn = s.fee + s.shipping + s.extra;
      s.total = goods + s.addOn;
    });
    services.sort(function (a, b) { return a.addOn - b.addOn; });
    var best = services[0].addOn;

    var html = services.map(function (s) {
      var diff = s.addOn - best;
      return '<div class="result' + (diff === 0 ? ' best' : '') + '">' +
        '<div class="result-top"><span class="result-name">' + s.name + '</span>' +
        '<span class="result-total">' + yen(s.total) + '</span></div>' +
        '<div class="result-break">' + yen(s.addOn) + ' on top of goods' +
        (diff > 0 ? ' · ' + yen(diff) + ' more than cheapest' : '') +
        ' — ' + s.note + '</div></div>';
    }).join('');

    html += '<div class="result quote"><div class="result-top">' +
      '<span class="result-name">Japan Rabbit</span>' +
      '<span class="result-total">Quote only</span></div>' +
      '<div class="result-break">Concierge pricing, quoted per request — for shops that block proxies outright</div></div>';

    html += '<div class="result"><div class="result-top">' +
      '<span class="result-name" style="color:var(--muted);font-weight:500">Goods subtotal</span>' +
      '<span class="result-total" style="font-weight:500">' + yen(goods) + '</span></div>' +
      '<div class="result-break">' + n + ' item' + (n > 1 ? 's' : '') + ' from ' + storeCount + ' seller' + (storeCount > 1 ? 's' : '') + ' · international shipping not included</div></div>';

    resultsEl.innerHTML = html + explain(services[0].name, storeCount, goods, n);
  }

  itemsEl.addEventListener('input', calculate);
  itemsEl.addEventListener('click', function (e) {
    if (!e.target.classList.contains('btn-remove')) return;
    if (itemsEl.querySelectorAll('.item-row').length <= 1) return;
    e.target.closest('.item-row').remove();
    calculate();
  });
  document.getElementById('addItem').addEventListener('click', function () {
    addRow();
    itemsEl.querySelector('.item-row:last-child .i-price').focus();
    calculate();
  });
  domesticEl.addEventListener('input', calculate);
  packingEl.addEventListener('change', calculate);

  SEED.forEach(function (it) { addRow(it.price, it.store); });
  calculate();
})();
</script>
