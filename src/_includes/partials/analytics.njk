{#
  計測タグ。値は src/_data/site.json の analytics に入れる。
  空のあいだは何も出力されないので、未設定でもビルドは通る。
#}
{% if site.analytics.googleSiteVerification %}
  <meta name="google-site-verification" content="{{ site.analytics.googleSiteVerification }}" />
{% endif %}
{% if site.analytics.cloudflareToken %}
  <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "{{ site.analytics.cloudflareToken }}"}'></script>
{% endif %}
{% if site.analytics.ga4MeasurementId %}
  {# GA4 はCookieを使うため、EU向けには同意バナーが別途必要。安易に有効化しないこと。 #}
  <script async src="https://www.googletagmanager.com/gtag/js?id={{ site.analytics.ga4MeasurementId }}"></script>
  <script>
    window.dataLayer = window.dataLayer || [];
    function gtag(){dataLayer.push(arguments);}
    gtag('js', new Date());
    gtag('config', '{{ site.analytics.ga4MeasurementId }}');
  </script>
{% endif %}
